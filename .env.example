# Copy to .env and fill in. Both keys are FREE, no credit card needed.
# Gemini: https://aistudio.google.com/apikey    Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: force a provider ("gemini" or "groq"). Default: whichever key is set (Gemini first).
# AGENTX_PROVIDER=groq
# Folder with your theme's data files. Defaults to ./data. The judges' harness sets this.
# AGENTX_DATA_DIR=./data
# Optional: override models (Groq retires/blocks models; run `curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models` to list yours)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
